# Supabase project URL and secret key (Project Settings > API Keys), for
# running the worker on your own machine. The secret key gives full access to
# the database, so keep this file to yourself.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Set to false to search for every new song instead of looking it up in the
# matches other cronchords users shared first (see "Sharing matches" in the
# README).
# USE_SHARED_MATCHES=false
